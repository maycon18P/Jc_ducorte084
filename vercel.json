{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": true,
  "rewrites": [
    { "source": "/barbeiro", "destination": "/barbeiro/index.html" },
    { "source": "/barbeiro/", "destination": "/barbeiro/index.html" },
    { "source": "/app", "destination": "/barbeiro/index.html" },
    { "source": "/app/", "destination": "/barbeiro/index.html" }
  ]
}
